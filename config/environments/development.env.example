# ==============================================================================
# ONEAG DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# (Safe template — commit NO real secrets to git)
# ==============================================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Firebase Configuration (Dev Project)
FIREBASE_PROJECT_ID=oneag-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dev@oneag-dev.iam.gserviceaccount.com
# Private keys must be injected via CI secrets or local environment variables:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Affiliate Network Webhook Verification (Dev / Sandbox)
# Set to sandbox endpoints for partner postbacks; keep disabled until verified.
AMAZON_ASSOCIATES_STATUS=DISABLED
FLIPKART_AFFILIATE_STATUS=DISABLED
MYNTRA_AFFILIATE_STATUS=DISABLED
MEESHO_AFFILIATE_STATUS=DISABLED

# Platform Safety
WITHDRAWAL_GLOBAL_LOCK=LOCKED
AUTH_REQUIRED_ADMIN_EMAIL=oneagofficial@gmail.com
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=0
