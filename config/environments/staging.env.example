# ==============================================================================
# ONEAG STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# (Safe template — commit NO real secrets to git)
# ==============================================================================

NODE_ENV=staging
PORT=3000
API_BASE_URL=https://api-staging.oneag.app

# Firebase Configuration (Staging Project)
FIREBASE_PROJECT_ID=oneag-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@oneag-staging.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Affiliate Networks (Strictly DISABLED in Staging until partner contracts are executed)
AMAZON_ASSOCIATES_STATUS=DISABLED
FLIPKART_AFFILIATE_STATUS=DISABLED
MYNTRA_AFFILIATE_STATUS=DISABLED
MEESHO_AFFILIATE_STATUS=DISABLED

# Platform Safety
WITHDRAWAL_GLOBAL_LOCK=LOCKED
AUTH_REQUIRED_ADMIN_EMAIL=oneagofficial@gmail.com
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=0
